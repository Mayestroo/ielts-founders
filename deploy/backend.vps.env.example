NODE_ENV=production
PORT=3000

# Required
DATABASE_URL=postgresql://ielts_user:replace_me@postgres-host:5432/ielts_db?schema=public
JWT_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret

# CORS
FRONTEND_URL=https://your-student-frontend.example.com
ADMIN_URL=https://your-admin-frontend.example.com

# Session/runtime Redis (exam sync/heartbeat/session)
SESSION_REDIS_PASSWORD=replace_session_redis_password
SESSION_REDIS_DB=0

# Queue Redis (writing grading queue)
QUEUE_REDIS_PASSWORD=replace_queue_redis_password
QUEUE_REDIS_DB=0

# Optional tuning
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
HTTP_CLIENT_TIMEOUT_MS=15000
AI_EVALUATION_TIMEOUT_MS=45000
AI_MAX_TOTAL_ATTEMPTS=12
EXAM_PERF_METRICS=true

# Optional: upload malware scanning command
# UPLOAD_SCAN_COMMAND=clamscan --no-summary {file}

# Optional: chaos controls for load tests only
# ENABLE_CHAOS_TESTING=true
# CHAOS_TOKEN=local-chaos-token
