# Environment variables for IELTS Mock Platform Backend
# Copy this file to .env and update values as needed

DATABASE_URL="postgresql://user:password@localhost:5432/ielts_mock"
JWT_SECRET="ielts-mock-platform-secret-key-2024"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="ielts-mock-platform-refresh-secret-2024"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis (session + queue)
# Prefer dedicated endpoints for exam session runtime and background queue workers.
SESSION_REDIS_URL="redis://localhost:6379/0"
QUEUE_REDIS_URL="redis://localhost:6380/0"

# Optional fallback (used when SESSION_/QUEUE_ vars are not set)
REDIS_URL="redis://localhost:6379/0"

# Temporary override only (non-production): allows shared session/queue Redis
ALLOW_SHARED_REDIS="false"

# Gemini AI API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key-here"

# Frontend URLs for CORS
FRONTEND_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3002"

# Backend URL for serving uploads
BACKEND_URL="http://localhost:3000"

PORT=3000
NODE_ENV=development
