  },
  {
    "atSeconds": 420,
    "label": "HTTP 502 for 15s",
    "command": "curl -s -X POST \"http://localhost:3000/api/health/chaos\" -H \"Content-Type: application/json\" -d '{\"token\":\"local-chaos-token\",\"http502Ms\":15000}'"
  }
